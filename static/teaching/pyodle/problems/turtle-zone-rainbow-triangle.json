{
  "id": "rainbow-triangle",
  "title": "Rainbow triangle",
  "instruction": "Draw a triangle with a thick pen, where every side is a different colour. A triangle turns 120 degrees at each corner.",
  "hint": "Change colour BEFORE drawing each side.",
  "turtle": true,
  "blocks": [
    {
      "id": "a",
      "code": "import turtle"
    },
    {
      "id": "b",
      "code": "t = turtle.Turtle()"
    },
    {
      "id": "c",
      "code": "t.pensize(6)"
    },
    {
      "id": "d",
      "code": "for colour in [\"red\", \"orange\", \"gold\"]:"
    },
    {
      "id": "e",
      "code": "t.color(colour)",
      "indent": 1
    },
    {
      "id": "f",
      "code": "t.forward(200)",
      "indent": 1
    },
    {
      "id": "g",
      "code": "t.left(120)",
      "indent": 1
    }
  ],
  "solutions": [
    [
      "a",
      "b",
      "c",
      "d",
      "e",
      "f",
      "g"
    ]
  ],
  "jumble": [
    "d",
    "c",
    "f",
    "a",
    "g",
    "b",
    "e"
  ]
}
