{
  "id": "badges",
  "title": "Star badges",
  "instruction": "make_badge() wraps a name in stars. If you don't say how many stars, it uses 1. Print a badge for a Rookie, then a Champion with 3 stars, then a Legend with 5.",
  "hint": "level=1 is a default: it's only used when the call leaves level out.",
  "blocks": [
    {
      "id": "a",
      "code": "def make_badge(name, level=1):"
    },
    {
      "id": "b",
      "code": "stars = \"*\" * level",
      "indent": 1
    },
    {
      "id": "c",
      "code": "return f\"{stars} {name} {stars}\"",
      "indent": 1
    },
    {
      "id": "d",
      "code": "print(make_badge(\"Rookie\"))"
    },
    {
      "id": "e",
      "code": "print(make_badge(\"Champion\", 3))"
    },
    {
      "id": "f",
      "code": "print(make_badge(\"Legend\", level=5))"
    }
  ],
  "solutions": [
    [
      "a",
      "b",
      "c",
      "d",
      "e",
      "f"
    ]
  ],
  "jumble": [
    "c",
    "a",
    "e",
    "b",
    "f",
    "d"
  ],
  "expectedOutput": [
    "* Rookie *",
    "*** Champion ***",
    "***** Legend *****"
  ]
}
