{
  "id": "rainbow-spiral",
  "title": "Rainbow spiral",
  "instruction": "Make a hypnotic rainbow spiral! Each line is a bit longer than the last (i * 4), and the colour cycles through the rainbow list.",
  "hint": "i % 6 counts 0, 1, 2, 3, 4, 5, 0, 1... so it always picks a colour from the list.",
  "turtle": true,
  "blocks": [
    {
      "id": "a",
      "code": "import turtle"
    },
    {
      "id": "b",
      "code": "t = turtle.Turtle()"
    },
    {
      "id": "c",
      "code": "colours = [\"red\", \"orange\", \"gold\", \"green\", \"blue\", \"purple\"]"
    },
    {
      "id": "d",
      "code": "for i in range(60):"
    },
    {
      "id": "e",
      "code": "t.color(colours[i % 6])",
      "indent": 1
    },
    {
      "id": "f",
      "code": "t.forward(i * 4)",
      "indent": 1
    },
    {
      "id": "g",
      "code": "t.left(59)",
      "indent": 1
    }
  ],
  "solutions": [
