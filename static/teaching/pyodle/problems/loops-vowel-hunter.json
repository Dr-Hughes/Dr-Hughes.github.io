{
  "id": "vowel-hunter",
  "title": "Vowel hunter",
  "instruction": "Ask for a word and check its letters one by one. Print each non-vowel you pass, and as soon as you find a vowel, announce it and break out of the loop. Finally print \"Hunt over.\".",
  "hint": "break jumps straight out of the loop, so it goes after the vowel is announced.",
  "blocks": [
    {
      "id": "a",
      "code": "word = input(\"Type a word: \")"
    },
    {
      "id": "b",
      "code": "for letter in word:"
    },
    {
      "id": "c",
      "code": "if letter in \"aeiou\":",
      "indent": 1
    },
    {
      "id": "d",
      "code": "print(f\"Found a vowel: {letter}\")",
      "indent": 2
    },
    {
      "id": "e",
      "code": "break",
      "indent": 2
    },
    {
      "id": "f",
      "code": "print(f\"{letter} is not a vowel\")",
      "indent": 1
    },
    {
      "id": "g",
      "code": "print(\"Hunt over.\")"
    }
  ],
  "solutions": [
    [
      "a",
      "b",
      "c",
      "d",
      "e",
      "f",
      "g"
    ]
  ],
  "jumble": [
    "g",
    "d",
    "f",
    "c",
    "a",
    "e",
    "b"
  ],
  "stdinDefault": "strength",
  "expectedOutput": [
    "Type a word: strength",
    "s is not a vowel",
    "t is not a vowel",
    "r is not a vowel",
    "Found a vowel: e",
    "Hunt over."
  ]
}
